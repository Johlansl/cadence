# Copy to .env and adjust before running docker compose.

# --- database ---
POSTGRES_USER=cadence
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cadence

# --- backend ---
# Shared secret for the admin provisioning endpoints (X-Admin-Key header).
# Generate a real one:  openssl rand -hex 32
CADENCE_ADMIN_KEY=change-me-admin

# --- deployment ---
# Host interface the published ports bind to.
#   127.0.0.1  -> local only (default, safe for a single-host test)
#   0.0.0.0    -> reachable from other VMs on the LAN (real-VM testing)
CADENCE_BACKEND_BIND=127.0.0.1
CADENCE_FRONTEND_BIND=127.0.0.1

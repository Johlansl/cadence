# Copy to .env and adjust before running docker compose.
#   scripts/gen-secrets.sh   writes .env from this file with random secrets.
#
# First run must be `docker compose up -d --build` (it builds the images the
# scheduler shares with the backend). The schema is created automatically by
# the backend entrypoint (Alembic); there is no manual migration step.

# --- database ---
POSTGRES_USER=cadence
# CAUTION: POSTGRES_PASSWORD is only read the first time the db volume is
# created. Changing it later does NOT update the database and the backend will
# fail to authenticate -- you must `docker compose down -v` (destroys data) or
# ALTER the role inside postgres. Set it correctly now.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cadence

# --- backend ---
# Shared secret for the admin provisioning endpoints (X-Admin-Key header).
# Generate a real one:  openssl rand -hex 32   (min 12 chars, or the backend
# refuses to start). gen-secrets.sh does this for you.
CADENCE_ADMIN_KEY=change-me-admin
# To rotate CADENCE_ADMIN_KEY without a flag day: put the new key above, move
# the old one here (both are then accepted), update clients, remove this line.
# CADENCE_ADMIN_KEY_PREVIOUS=

# Encrypts agent_tokens.secret_encrypted at rest, so a signed agent request can
# be verified (needs the real secret, not a one-way hash). Required; the
# backend refuses to start without a valid one. Generate a real one:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# gen-secrets.sh does this for you. Rotate the same way as CADENCE_ADMIN_KEY:
# put the new key above, move the old one to _PREVIOUS, drop _PREVIOUS once
# every row using it has been re-encrypted.
CADENCE_TOKEN_ENCRYPTION_KEY=change-me-fernet-key
# CADENCE_TOKEN_ENCRYPTION_KEY_PREVIOUS=

# Interactive API docs (/docs, /redoc) and the OpenAPI schema (/openapi.json).
# Off in production: they publish the full route map and carry no credential on
# the backend port. Set to true in a local dev .env if you want them (they then
# sit behind the same Caddy basic-auth as the read API).
CADENCE_API_DOCS_ENABLED=false

# --- rate limiting ---
# Volume cap on *successful* authenticated traffic, separate from the always-on
# auth-failure throttle. Per fixed window: the agent path is keyed by its token,
# the admin and dashboard/read paths by client IP. Over the cap -> 429 with a
# Retry-After header. Values below are the code defaults; the agent cap sits far
# above the real ~1 poll/min cadence. Set CADENCE_RATELIMIT_ENABLED=false to
# turn the whole thing off (there is no per-surface 0 = disabled).
CADENCE_RATELIMIT_ENABLED=true
CADENCE_RATELIMIT_WINDOW_SECONDS=60
CADENCE_RATELIMIT_AGENT_MAX=20
CADENCE_RATELIMIT_ADMIN_MAX=60
CADENCE_RATELIMIT_DASHBOARD_MAX=120

# --- dashboard access ---
# Basic-auth gate (at Caddy) on the dashboard and the read/admin API; the agent
# endpoints are exempt. ON by default. `scripts/gen-secrets.sh` fills USER +
# PASSWORD_HASH and prints the password once.
CADENCE_DASHBOARD_AUTH=on
CADENCE_DASHBOARD_USER=cadence
# bcrypt hash, NOT the plaintext -- and EVERY `$` is doubled ($$), because
# docker compose interpolates single `$` in this file. gen-secrets.sh (first
# setup) and rotate-dashboard-password.sh (later) do this for you; Caddy also
# refuses to start if the hash is malformed, so a missed `$$` fails loudly
# instead of silently breaking the login. To set it by hand:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>' | sed 's/[$]/$$/g'
# This placeholder is the (doubled) hash of "change-me".
CADENCE_DASHBOARD_PASSWORD_HASH=$$2a$$14$$9RzS8dzkDp0vCxfkusQZR.1l95oLIGKbReMUMdZwJ77Dz9SNKXqra
# Set to `off` to disable the gate -- only on a network you fully trust.
# CADENCE_DASHBOARD_AUTH=off

# Retention, applied once a day by the scheduler service. 0 = keep forever.
# reports keeps the raw report log; jobs applies to succeeded/failed only;
# audit is the admin action trail (kept longer -- it is small).
CADENCE_REPORTS_RETENTION_DAYS=90
CADENCE_JOBS_RETENTION_DAYS=90
CADENCE_AUDIT_RETENTION_DAYS=365

# A job left "running" longer than this (agent claimed it then never reported
# back) is failed by the scheduler so it stops blocking the host. 0 = disabled.
CADENCE_JOB_RUNNING_TIMEOUT_SECONDS=7200

# Thresholds injected into every apt_upgrade job. The agent checks each
# distinct filesystem backing /var, /boot and /boot/efi; absent boot paths are
# ignored. A package-manager lock may clear during the bounded wait.
CADENCE_UPGRADE_MINIMUM_AVAILABLE_BYTES=1073741824
CADENCE_UPGRADE_BOOT_MINIMUM_AVAILABLE_BYTES=209715200
CADENCE_UPGRADE_LOCK_WAIT_SECONDS=120

# --- outbound webhooks ---
# The server POSTs a signed JSON body to each configured webhook URL when a
# subscribed event fires (job.succeeded/failed, host.offline/reboot_required/
# security_updates_available). All optional; the feature is inert until a
# webhook is configured via the dashboard. Set false to hard-disable it.
CADENCE_WEBHOOKS_ENABLED=true
# Per-attempt HTTP timeout for a delivery.
CADENCE_WEBHOOK_TIMEOUT_SECONDS=10
# Attempts before a delivery is parked "failed"; backoff is 60s, 120s, ... 1h.
CADENCE_WEBHOOK_MAX_ATTEMPTS=6
# Pending deliveries drained per scheduler tick (~60s).
CADENCE_WEBHOOK_DISPATCH_BATCH=20
# last_seen_at age past which an active host is reported offline (once).
CADENCE_WEBHOOK_OFFLINE_AFTER_SECONDS=900
# Terminal (delivered/failed) delivery rows are pruned by the daily sweep after
# this many days. 0 = keep forever.
CADENCE_WEBHOOK_DELIVERIES_RETENTION_DAYS=30
# Cap on the job log embedded in job.* payloads (head+tail kept). 0 = full log.
CADENCE_WEBHOOK_LOG_MAX_BYTES=4096

# --- campaigns ---
# Default quiet time between a campaign's stages: a stage advances only once all
# its jobs are terminal AND this many seconds have passed with no halt.
# Overridable per campaign in the create request. 0 = advance immediately.
CADENCE_CAMPAIGN_OBSERVATION_WINDOW_SECONDS=600

# Log level for the backend and scheduler (DEBUG/INFO/WARNING/ERROR). Output is
# logfmt (ts=... level=... logger=... msg=... key=value).
CADENCE_LOG_LEVEL=INFO

# --- deployment ---
# Public entrypoint: the Caddy reverse proxy, TLS terminated with its own
# internal CA. Must be a hostname resolving to this server on your LAN
# (LAN DNS, or /etc/hosts on clients + monitored VMs).
CADENCE_SITE_ADDRESS=cadence.lan
# Interface Caddy's 80/443 ports bind to (0.0.0.0 to serve the LAN).
CADENCE_HTTP_BIND=0.0.0.0

# Interface the backend / plain-HTTP frontend ports bind to. Kept on loopback:
# LAN traffic goes through Caddy. Set to 0.0.0.0 only for direct, TLS-less
# access (debugging).
CADENCE_BACKEND_BIND=127.0.0.1
CADENCE_FRONTEND_BIND=127.0.0.1

# Reverse-proxy networks whose X-Forwarded-For is trusted. Empty (default):
# the header is ignored and the direct connection IP is used for the auth
# throttle and the audit `client` column -- safe, but behind the bundled
# Caddy+nginx that is always the nginx container's IP. Set it to the compose
# network subnet to record the real client:
#   docker network inspect cadence_default \
#     --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# CADENCE_TRUSTED_PROXIES=172.18.0.0/16

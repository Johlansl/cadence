# Cadence reverse proxy. One public entrypoint, TLS terminated here.
#
# CADENCE_SITE_ADDRESS must be a hostname that resolves to this server for every
# client and monitored host (LAN DNS or /etc/hosts). With a bare hostname Caddy
# issues a certificate from its own internal CA -- export it to the hosts, see
# README "Trust Caddy's internal CA". For a public domain + Let's Encrypt, drop
# `tls internal` below and add an ACME email.

# Basic-auth gate on the dashboard and the read/admin API. On by default. The
# agent endpoints authenticate with per-host signed HMAC requests, not these
# credentials, so they are exempt.
(on) {
	@dashboard not path /api/v1/reports /api/v1/agent/* /api/v1/jobs/*/result
	basic_auth @dashboard {
		{$CADENCE_DASHBOARD_USER} {$CADENCE_DASHBOARD_PASSWORD_HASH}
	}
}

# CADENCE_DASHBOARD_AUTH=off imports this instead: no gate. Only on a network
# you fully trust (a VPN, a management VLAN).
(off) {
}

# Plain HTTP: everything redirects to HTTPS, except the agent bootstrap assets
# (the installer, the binary, the CA itself) -- those must be reachable before
# the host trusts the internal CA. Populated by scripts/publish-agent.sh.
http://{$CADENCE_SITE_ADDRESS} {
	# defer so -Server also strips it from Caddy-generated responses.
	header {
		defer
		-Server
		X-Content-Type-Options nosniff
	}

	@bootstrap path /install.sh /agent/*
	handle @bootstrap {
		root * /srv/dist
		file_server
	}
	handle {
		redir https://{host}{uri}
	}
}

{$CADENCE_SITE_ADDRESS} {
	tls internal
	encode gzip

	# defer so every field (Server removal included) lands on Caddy's own
	# responses too, e.g. the basic_auth 401. The CSP is enforcing: the
	# dashboard is a self-contained Vite build -- one same-origin <script>
	# and <link>, no inline code, no external assets, no eval -- so 'self'
	# with no 'unsafe-inline' holds (verified against a real browser
	# console). Was shipped Report-Only first.
	header {
		defer
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Cross-Origin-Opener-Policy same-origin
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
		# The dashboard is a self-contained inventory UI: no device sensors,
		# camera/mic, geolocation, Payment Request, WebUSB, screen capture or
		# programmatic fullscreen; interest-cohort=() opts out of FLoC.
		Permissions-Policy "accelerometer=(), camera=(), display-capture=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
		# Legacy header. 0 = disable the old XSS auditor (removed from Chrome,
		# never in Firefox, caused info-leak bugs); the enforcing CSP above is
		# the real defense. OWASP Secure Headers recommends exactly this.
		X-XSS-Protection "0"
	}
	# basic_auth's 401 is a Caddy-generated error response and bypasses the
	# handler chain above; re-apply the same hardening on the error path.
	handle_errors {
		header {
			defer
			-Server
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy no-referrer
			Cross-Origin-Opener-Policy same-origin
			Permissions-Policy "accelerometer=(), camera=(), display-capture=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
			X-XSS-Protection "0"
		}
		respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
	}

	import {$CADENCE_DASHBOARD_AUTH:on}

	# nginx in the frontend image already proxies /api/ to backend:8000,
	# so everything can go to a single upstream.
	reverse_proxy frontend:80
}

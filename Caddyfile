# Cadence reverse proxy. One hostname, separate TLS listeners for humans and
# agents: 443 is dashboard/bootstrap, 8443 requires an agent client certificate.

# Basic-auth gate on the dashboard and read/admin API. Enrollment, authenticated
# install assets and agent routes have their own controls and are excluded.
(on) {
	@dashboard not path /install.sh /agent/* /api/v1/reports /api/v1/agent/* /api/v1/jobs/*/result
	basic_auth @dashboard {
		{$CADENCE_DASHBOARD_USER} {$CADENCE_DASHBOARD_PASSWORD_HASH}
	}
}

(off) {
}

# Temporary compatibility path for agents without a client certificate. The
# compose preflight requires an explicit on/off value, so a deployment cannot
# silently choose whether the existing fleet remains reachable.
(legacy-on) {
	@legacy_agent path /api/v1/reports /api/v1/agent/* /api/v1/jobs/*/result
	handle @legacy_agent {
		reverse_proxy backend:8000 {
			header_up -X-Cadence-Client-Cert-Fingerprint
			header_up X-Cadence-Transport legacy
			header_up X-Cadence-Proxy-Key {$CADENCE_INTERNAL_PROXY_KEY}
		}
	}
}

(legacy-off) {
	@legacy_agent path /api/v1/reports /api/v1/agent/* /api/v1/jobs/*/result
	handle @legacy_agent {
		respond 404
	}
}

# First contact on plain HTTP. This is deliberately the only handle before the
# catch-all redirect: no installer, binary, checksum, signature or systemd unit
# can be retrieved without authenticated HTTPS.
http://{$CADENCE_SITE_ADDRESS} {
	header {
		defer
		-Server
		X-Content-Type-Options nosniff
	}

	@ca path /agent/ca.crt
	handle @ca {
		root * /srv/dist
		file_server
	}
	handle {
		redir https://{host}{uri}
	}
}

# Dashboard, admin API, enrollment exchange and authenticated install assets.
https://{$CADENCE_SITE_ADDRESS}:443 {
	tls internal
	encode gzip

	header {
		defer
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Cross-Origin-Opener-Policy same-origin
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
		Permissions-Policy "accelerometer=(), camera=(), display-capture=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
		X-XSS-Protection "0"
	}
	handle_errors {
		header {
			defer
			-Server
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy no-referrer
			Cross-Origin-Opener-Policy same-origin
			Permissions-Policy "accelerometer=(), camera=(), display-capture=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
			X-XSS-Protection "0"
		}
		respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
	}

	@assets path /install.sh /agent/*
	handle @assets {
		root * /srv/dist
		file_server
	}

	@enrollment path /api/v1/agent/enroll
	handle @enrollment {
		reverse_proxy backend:8000 {
			header_up -X-Cadence-Client-Cert-Fingerprint
			header_up X-Cadence-Transport enrollment
			header_up X-Cadence-Proxy-Key {$CADENCE_INTERNAL_PROXY_KEY}
		}
	}

	import legacy-{$CADENCE_LEGACY_AGENT_ENDPOINTS:off}
	import {$CADENCE_DASHBOARD_AUTH:on}
	reverse_proxy frontend:80
}

# Post-enrollment agent listener. Caddy verifies the client chain before HTTP
# routing; the backend additionally binds its leaf fingerprint to the host
# authenticated by the unchanged per-request HMAC.
https://{$CADENCE_SITE_ADDRESS}:{$CADENCE_AGENT_PORT:8443} {
	tls {
		issuer internal
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file /etc/cadence/client-pki/client-root-ca.crt
			}
		}
	}
	encode gzip
	header {
		defer
		-Server
		X-Content-Type-Options nosniff
	}

	@agent_api {
		path /api/v1/reports /api/v1/agent/* /api/v1/jobs/*/result
		not path /api/v1/agent/enroll
	}
	handle @agent_api {
		reverse_proxy backend:8000 {
			header_up X-Cadence-Transport mtls
			header_up X-Cadence-Proxy-Key {$CADENCE_INTERNAL_PROXY_KEY}
			header_up X-Cadence-Client-Cert-Fingerprint {http.request.tls.client.fingerprint}
		}
	}
	handle {
		respond 404
	}
}

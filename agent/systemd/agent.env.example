# Installed as /etc/cadence/agent.env -- read by cadence-agent.service.
# Contains the per-host token: keep it chmod 0600, root-owned.

CADENCE_SERVER_URL=https://cadence.example.lan
CADENCE_TOKEN=replace-with-the-per-host-token

# Refresh the apt lists before each report so the dashboard reflects what apt
# would install right now, instead of trusting the system's ~daily apt-daily
# timer. Set to false on a metered link or a very large fleet.
CADENCE_RUN_APT_UPDATE=true

# Optional:
# CADENCE_ENABLE_UPGRADES=true          # allow the server to trigger apt dist-upgrade
# CADENCE_ENABLE_UPGRADES=true          # allow the server to trigger apt dist-upgrade
# CADENCE_ENABLE_REBOOT=true            # kill-switch: if false, never reboot even when
#                                       # the job's reboot mode is "auto"
# CADENCE_HTTP_TIMEOUT_SECONDS=30

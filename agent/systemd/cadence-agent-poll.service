[Unit]
Description=Cadence agent -- claim and run a pending job (fast poll)
Documentation=file:/usr/local/share/doc/cadence/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/cadence/agent.env
ExecStart=/usr/local/bin/cadence-agent -poll

# Does nothing when no job is pending; when one is, it runs apt-get dist-upgrade
# and then a follow-up report. Must exceed jobTimeout + postJobReportTimeout
# (cmd/agent/main.go = 65 min) with margin, or systemd SIGKILLs apt/dpkg.
TimeoutStartSec=4500
Nice=10
IOSchedulingClass=idle

ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# No [Install] section: started by cadence-agent-poll.timer.

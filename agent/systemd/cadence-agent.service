[Unit]
Description=Cadence patch-management agent (one-shot report)
Documentation=file:/usr/local/share/doc/cadence/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/cadence/agent.env
ExecStart=/usr/local/bin/cadence-agent

# A run may collect, POST a report, and then run a piggybacked apt-get
# dist-upgrade job plus a follow-up report. Must exceed the sum of the agent's
# own timeouts on this path (reportTimeout + jobTimeout + postJobReportTimeout
# in cmd/agent/main.go = 45 min) with margin, or systemd SIGKILLs apt/dpkg
# mid-transaction. Keep the run low priority.
TimeoutStartSec=3600
Nice=10
IOSchedulingClass=idle

# Light sandboxing (the agent only reads dpkg/apt state and POSTs a report;
# apt-get update, when enabled, still works under these).
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# No [Install] section: this unit is started by cadence-agent.timer
# (or manually via `systemctl start cadence-agent.service`).

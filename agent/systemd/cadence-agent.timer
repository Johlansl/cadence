[Unit]
Description=Run the Cadence agent periodically

[Timer]
# First run soon after boot (also confirms reboot-required is cleared), then
# every 30 min relative to the last run.
OnBootSec=1min
OnUnitActiveSec=30min
# Spread load across a fleet so reports don't all hit the server at once.
RandomizedDelaySec=5min
# Catch up with one run if the machine was off when a run was due.
Persistent=true
Unit=cadence-agent.service

[Install]
WantedBy=timers.target
